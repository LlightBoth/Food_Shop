@inherits LayoutComponentBase

@using FoodShop.WebApps.Services

@inject IJSRuntime JS
@inject CurrentUser CurrentUser
@inject UserSession UserSession
@inject NavigationManager NavManager

<link href="/css/employee/empLayout.css" rel="stylesheet" />
<link href="/css/layout/app.css" rel="stylesheet" />


<div class="emp-container" data-theme="@mode">

    <header class="emp-header px-4 d-flex align-items-center justify-content-between">
        <a href="/profile/@userId" class="profile-link d-flex align-items-center gap-2 fw-semibold">
            <i class="bi bi-person-circle fs-5"></i>
            <span>@username</span>
        </a>

        <div class="dropdown">
            <button class="btn btn-outline-light dropdown-toggle d-flex align-items-center gap-2"
                    type="button"
                    @onclick="ToggleDropdown">
                <i class="bi bi-gear-fill"></i> Settings
            </button>

            <ul class="dropdown-menu dropdown-menu-end shadow-sm @(isDropdownOpen ? "show" : "")">
                <li>
                    <button class="dropdown-item d-flex align-items-center gap-2" type="button" @onclick="MyProfile">
                        <i class="bi bi-person fs-6 text-muted"></i> Profile
                    </button>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <button class="dropdown-item d-flex align-items-center gap-2 text-danger" type="button" @onclick="IsLogout">
                        <i class="bi bi-box-arrow-right fs-6"></i> Log-out
                    </button>
                </li>
            </ul>
        </div>
    </header>

    <aside class="emp-aside">
        <div class="w-100 overflow-auto">
            <nav class="nav flex-row flex-md-column emp-nav gap-1 p-2 text-nowrap flex-nowrap">
                <a class="nav-link active d-flex align-items-center" href="/dashboard">
                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                </a>
                <a class="nav-link d-flex align-items-center" href="/delivery">
                    <i class="bi bi-truck me-2"></i> Delivery
                </a>
                <a class="nav-link d-flex align-items-center" href="/category">
                    <i class="bi bi-tags me-2"></i> Category
                </a>
                <a class="nav-link d-flex align-items-center" href="/food">
                    <i class="bi bi-egg-fried me-2"></i> Food
                </a>
                <a class="nav-link d-flex align-items-center" href="/invoice">
                    <i class="bi bi-receipt me-2"></i> Invoice
                </a>
                <a class="nav-link d-flex align-items-center" href="/customer">
                    <i class="bi bi-people me-2"></i> Customer
                </a>
                <a class="nav-link d-flex align-items-center" href="/employee">
                    <i class="bi bi-person-badge me-2"></i> Employee
                </a>
                <a class="nav-link d-flex align-items-center" href="/job">
                    <i class="bi bi-briefcase me-2"></i> Job
                </a>
                <a class="nav-link d-flex align-items-center" href="/role">
                    <i class="bi bi-shield-lock me-2"></i> Role
                </a>
                <a class="nav-link d-flex align-items-center" href="/page">
                    <i class="bi bi-file-earmark me-2"></i> Page
                </a>

                <hr class="text-secondary my-2 d-none d-md-block">

                <a class="nav-link d-flex align-items-center text-success" href="/">
                    <i class="bi bi-shop me-2"></i> Food-Shop
                </a>
            </nav>
        </div>
    </aside>

    <section class="emp-main">
        <main class="emp-content">
            @Body
        </main>
    </section>

    <footer class="emp-footer">
        <p>&copy; 2026 Employee site - All Rights Reserved</p>
    </footer>


    <div class="theme-selector">
        <button class="theme-btn @(mode == "light" ? "active" : "")" @onclick='() => ToggleTheme("light")'>
            <i>☀️</i>
        </button>
        <button class="theme-btn @(mode == "dark" ? "active" : "")" @onclick='() => ToggleTheme("dark")'>
            <i>🌙</i>
        </button>
    </div>
</div>

@code {
    private string username { get; set; } = "Emp";
    private int userId { get; set; }
    private string mode { get; set; } = "light";
    private bool isDropdownOpen = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        mode = await JS.InvokeAsync<string>("loadTheme");


        var session = await CurrentUser.GetUserUsernameAsync();
        var sessionId = await CurrentUser.GetUserIdAsync();

        if (session != null)
        {
            username = session;
            userId = (int)sessionId;


            StateHasChanged();
        }
    }

    private async Task ToggleTheme(string newMode)
    {
        mode = newMode;
        await JS.InvokeVoidAsync("setTheme", mode);
    }

    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
    }

    private async Task MyProfile()
    {
        isDropdownOpen = false;
        NavManager.NavigateTo($"/profile/{userId}");
    }
    private async Task IsLogout()
    {
        isDropdownOpen = false;
        await CurrentUser.ClearUserSession();
        NavManager.NavigateTo("/login");
    }
}