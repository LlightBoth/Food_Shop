@inherits LayoutComponentBase

@using FoodShop.WebApps.Services
@inject CartServices CartSvc
@inject CurrentUser user
@inject NavigationManager NavManager
@inject IJSRuntime JS

@implements IDisposable

<link href="/css/layout/app.css" rel="stylesheet" />


<div class="app-container" data-theme="@mode">

    <header class="app-header py-2 shadow-sm sticky-top">
        <div class="container-fluid px-4">
            <nav class="d-flex align-items-center justify-content-between">

                <NavLink href="/" class="brand-logo fs-4 fw-bold text-decoration-none">
                    @* Image Logo *@
                    FoodShop
                </NavLink>

                <div class="d-flex align-items-center gap-3 ms-auto">

                    <div class="d-none d-md-flex align-items-center gap-2 main-nav-links">
                        <NavLink href="/" class="nav-item-link" Match="NavLinkMatch.All">Home</NavLink>
                        <NavLink href="/menu" class="nav-item-link">Menu</NavLink>
                        <NavLink href="/about" class="nav-item-link">About</NavLink>
                    </div>

                    <NavLink href="/cart" class="cart-link position-relative mx-2">
                        <i class="bi bi-cart3 fs-4"></i>
                        @if (CartCount > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger cart-badge">
                                @CartCount
                            </span>
                        }
                    </NavLink>

                    @if (user.IsLoggedIn)
                    {
                        <div class="dropdown">
                            <button class="btn btn-user-dropdown dropdown-toggle d-flex align-items-center gap-2 px-3 py-2 text-dark"
                                    type="button"
                                    @onclick="ToggleDropdown">
                                <i class="bi bi-gear"></i>
                                <span class="d-none d-sm-inline">Setting</span>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 @(isDropdownOpen ? "show" : "")">
                                <li>
                                    <button class="dropdown-item d-flex align-items-center gap-2" type="button" @onclick="MyProfile">
                                        <i class="bi bi-person text-muted"></i> Profile
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item d-flex align-items-center gap-2" type="button" @onclick="MyOrders">
                                        <i class="bi bi-bag-check text-muted"></i> My Orders
                                    </button>
                                </li>
                                @if (user.Session.IsEmployee)
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <button class="dropdown-item d-flex align-items-center gap-2 text-primary" type="button" @onclick="MyDashboard">
                                            <i class="bi bi-speedometer2"></i> Dashboard
                                        </button>
                                    </li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <button class="dropdown-item d-flex align-items-center gap-2 text-danger" type="button" @onclick="IsLogout">
                                        <i class="bi bi-box-arrow-right"></i> Log-out
                                    </button>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <NavLink href="/login" class="btn btn-login px-4 rounded-pill fw-semibold">Login</NavLink>
                    }
                </div>
            </nav>
        </div>
    </header>

    <div class="theme-selector">
        <button class="theme-btn @(mode == "light" ? "active" : "")" @onclick='() => ToggleTheme("light")'>
            <i>☀️</i>
        </button>
        <button class="theme-btn @(mode == "dark" ? "active" : "")" @onclick='() => ToggleTheme("dark")'>
            <i>🌙</i>
        </button>
    </div>

    <main class="app-content">
        @Body
    </main>

    <footer class="app-footer">
        <p>&copy; 2026 FoodieHub - All Rights Reserved</p>
    </footer>

</div>

@code {
    private int CartCount => CartSvc.Items.Sum(x => x.Quantity);
    private int userId { get; set; }
    private string mode = "light";
    private bool isDropdownOpen = false;

    protected override void OnInitialized()
    {
        CartSvc.OnChange += StateHasChanged;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // We must wait for firstRender because JSInterop
            await user.LoadUserSession();
            // isn't available until the browser is ready
            await CartSvc.LoadCart();

            mode = await JS.InvokeAsync<string>("loadTheme");

            var sessionId = await user.GetUserIdAsync();

            if (sessionId != null)
            {
                userId = (int)sessionId;
                StateHasChanged();
            }

            // Tell the ui to refresh 
            StateHasChanged();
        }
    }

    private async Task IsLogout()
    {
        await user.ClearUserSession();
        NavManager.NavigateTo("/login");
    }
    private async Task ToggleTheme(string newMode)
    {
        mode = newMode;
        await JS.InvokeVoidAsync("setTheme", mode);
    }
    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
    }

    private async Task MyProfile()
    {
        isDropdownOpen = false; // Close menu after click
        NavManager.NavigateTo($"/customer-profile/{userId}");
    }
         
    private async Task MyOrders()
    {
        isDropdownOpen = false; // Close menu after click
        NavManager.NavigateTo("/orders");
    }
    private async Task MyDashboard()
    {
        isDropdownOpen = false; // Close menu after click
        NavManager.NavigateTo($"dashboard");
    }
    public void Dispose()
    {
        // Unsubscribe when the component is destroyed to prevent memory leaks
        CartSvc.OnChange -= StateHasChanged;
    }
}