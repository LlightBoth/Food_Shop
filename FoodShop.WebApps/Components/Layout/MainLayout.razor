@inherits LayoutComponentBase

@using FoodShop.WebApps.Services
@inject CartServices CartSvc
@inject CurrentUser user
@inject NavigationManager NavManager
@inject IJSRuntime JS

@implements IDisposable

<link href="/css/layout/app.css" rel="stylesheet" />

<div class="app-container" data-theme="@mode">

    <header class="app-header">
        <div class="container-fluid">
            <nav class="d-flex align-items-center">
                <NavLink href="/" class="fs-4 fw-bold text-white me-auto">FoodieHub</NavLink>

                <NavLink href="/" class="d-none d-md-block">Home</NavLink>
                <NavLink href="/menu">Menu</NavLink>
                <NavLink href="/about" class="d-none d-md-block">About</NavLink>

                <NavLink href="/cart" class="cart-link btn position-relative text-white mx-2">
                    <i class="bi bi-cart3 fs-4"></i>
                    @if (CartCount > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger cart-badge">
                            @CartCount
                        </span>
                    }
                </NavLink>

                @if (user.IsLoggedIn)
                {
                    <!-- Bootstrap Dropdown Container -->
                    <div class="dropdown">
                        <!-- Toggle Button -->
                        <button class="btn btn-outline-primary btn-light dropdown-toggle"
                                type="button"
                                @onclick="ToggleDropdown">
                            Setting ⚙️
                        </button>

                        <!-- Dropdown Menu (Bootstrap classes handle the styling, Blazor handles the visibility) -->
                        <ul class="dropdown-menu dropdown-menu-end @(isDropdownOpen ? "show" : "")">
                            <li>
                                <button class="dropdown-item" type="button" @onclick="MyProfile">
                                    Profile
                                </button>
                            </li>
                            <li>
                                <button class="dropdown-item" type="button" @onclick="MyOrders">
                                    My Orders
                                </button>
                            </li>
                            @if (user.Session.IsEmployee)
                            {
                                <li>
                                    <button class="dropdown-item" type="button" @onclick="MyDashboard">Dashboard</button>
                                </li>
                            }
                            <li>
                                <button class="dropdown-item" type="button" @onclick="IsLogout">
                                    Log-out
                                </button>
                            </li>
                        </ul>
                    </div>

                    <div class="d-flex gap-2 align-items-center">
                        
                    </div>
                }
                else
                {
                    <NavLink href="/login" class="btn btn-outline-light btn-sm">Login</NavLink>
                }
            </nav>
        </div>
    </header>
    
    <div class="theme-selector">
        <button class="theme-btn @(mode == "light" ? "active" : "")" @onclick='() => ToggleTheme("light")'>
            <i>☀️</i>
        </button>
        <button class="theme-btn @(mode == "dark" ? "active" : "")" @onclick='() => ToggleTheme("dark")'>
            <i>🌙</i>
        </button>
    </div>

    <main class="app-content">
        @Body
    </main>

    <footer class="app-footer">
        <p>&copy; 2026 FoodieHub - All Rights Reserved</p>
    </footer>

</div>

@code {
    private int CartCount => CartSvc.Items.Sum(x => x.Quantity);
    private int userId { get; set; }
    private string mode = "light";
    private bool isDropdownOpen = false;

    protected override void OnInitialized()
    {
        CartSvc.OnChange += StateHasChanged;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // We must wait for firstRender because JSInterop
            await user.LoadUserSession();
            // isn't available until the browser is ready
            await CartSvc.LoadCart();

            var sessionId = await user.GetUserIdAsync();

            if (sessionId != null)
            {
                userId = (int)sessionId;
                StateHasChanged();
            }

            // Tell the ui to refresh 
            StateHasChanged();
        }
    }

    private async Task IsLogout()
    {
        await user.ClearUserSession();
    }
    private async Task ToggleTheme(string newMode)
    {
        mode = newMode;
        await JS.InvokeVoidAsync("setTheme", mode);
    }
    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
    }

    private async Task MyProfile()
    {
        isDropdownOpen = false; // Close menu after click
        NavManager.NavigateTo($"/customer-profile/{userId}");
    }
         
    private async Task MyOrders()
    {
        isDropdownOpen = false; // Close menu after click
        NavManager.NavigateTo("/orders");
    }
    private async Task MyDashboard()
    {
        isDropdownOpen = false; // Close menu after click
        NavManager.NavigateTo($"dashboard");
    }
    public void Dispose()
    {
        // Unsubscribe when the component is destroyed to prevent memory leaks
        CartSvc.OnChange -= StateHasChanged;
    }
}