@layout FoodShop.WebApps.Components.Layout.AccessDeniedLayout
@page "/access-denied"
@inject NavigationManager NavManager

@using FoodShop.WebApps.Services

@inject UserSession UserSession



<div class="denied-container" data-theme="@mode">
    <div class="denied-card">
        <div class="denied-icon">
            <i class="bi bi-shield-lock-fill"></i>
        </div>

        <h1 class="display-5 fw-bold">403</h1>
        <h2 class="h4">Access Restricted</h2>
        <p class="text-muted">
            You don't have permission to view this resource.
            Please contact your administrator if you believe this is an error.
        </p>

        <hr class="my-4" />

        <div class="d-grid gap-2 d-md-block">
            <button class="btn btn-primary px-4" @onclick="GoHome">
                <i class="bi bi-house-door pe-2"></i>Home
            </button>
            <button class="btn btn-outline-secondary px-4" @onclick="GoBack">
                <i class="bi bi-arrow-left pe-2"></i>Back
            </button>
        </div>

        <div class="mt-4">
            <button class="btn btn-link btn-sm text-decoration-none" @onclick="ToggleTheme">
                <i class="bi @(mode == "light" ? "bi-moon-stars" : "bi-sun") pe-1"></i>
                Switch to @(mode == "light" ? "Dark" : "Light") Mode
            </button>
        </div>
    </div>
</div>

@code {
    private string mode = "light";

    private void ToggleTheme() => mode = (mode == "light") ? "dark" : "light";

    private void GoHome() => NavManager.NavigateTo("/");

    private void GoBack() => NavManager.NavigateTo(UserSession.PreviousURI);
}