@page "/delivery/{InvoiceId:int}"
@layout FoodShop.WebApps.Components.Layout.EmployeeLayout

@using FoodShop.WebApps.Services
@using Microsoft.EntityFrameworkCore
@inject FoodShopDbContext db
@inject NavigationManager navigation
@inject UserSession UserSession

<div class="dashboard-wrapper">
    <div class="container py-4">
        <!-- Back Button & Header -->
        <div class="mb-4">
            <button class="btn btn-link text-decoration-none p-0 mb-2" @onclick='() => navigation.NavigateTo("/delivery_mydelivery")'>
                <i class="fas fa-arrow-left"></i> Back to Dispatch
            </button>
            <h3 class="fw-bold">Complete Delivery #@InvoiceId</h3>
        </div>

        @if (invoice == null)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2">Loading order details...</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                <!-- Left Column: Customer & Items -->
                <div class="col-lg-8">
                    <div class="card custom-card shadow-sm mb-4">
                        <div class="card-header bg-transparent border-bottom py-3">
                            <h5 class="mb-0"><i class="fas fa-user me-2"></i>Customer Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="text-muted small uppercase">Name</label>
                                    <p class="fw-bold mb-0">@invoice.Customer?.CustomerName</p>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="text-muted small uppercase">Phone Number</label>
                                    <p class="fw-bold mb-0">@invoice.Customer?.Phone</p>
                                </div>
                                <div class="col-12">
                                    <label class="text-muted small uppercase">Delivery Address</label>
                                    <p class="mb-0"><i class="fas fa-map-marker-alt text-danger me-1"></i> @invoice.Customer?.Address</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card custom-card shadow-sm">
                        <div class="card-header bg-transparent border-bottom py-3">
                            <h5 class="mb-0"><i class="fas fa-shopping-basket me-2"></i>Order Summary</h5>
                        </div>
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Product</th>
                                        <th class="text-center">Qty</th>
                                        <th class="text-end pe-4">Price</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var detail in invoice.InvoiceDetails)
                                    {
                                        <tr>
                                            <td class="ps-4">@detail.Foods?.FoodName</td>
                                            <td class="text-center">@detail.Qty.ToString()</td>
                                            <td class="text-end pe-4">$@detail.Foods?.SellPrice.ToString("F2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Payment & Action -->
                <div class="col-lg-4">
                    <div class="card custom-card shadow-sm border-primary">
                        <div class="card-body">
                            <h5 class="fw-bold mb-4">Finalize Order</h5>

                            <div class="d-flex justify-content-between mb-2">
                                <span>Subtotal</span>
                                <span>$@invoice.TotalAmount.ToString("F2")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-4">
                                <span class="fw-bold">Total to Collect</span>
                                <span class="fw-bold fs-4 text-primary">$@invoice.TotalAmount.ToString("F2")</span>
                            </div>

                            <div class="alert alert-info small">
                                <i class="fas fa-info-circle me-1"></i>
                                Ensure you have received payment before marking as complete.
                            </div>

                            <button class="btn btn-success w-100 py-3 fw-bold"
                                    @onclick="MarkAsComplete"
                                    disabled="@isProcessing">
                                @if (isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="fas fa-check-circle me-1"></i> CONFIRM DELIVERY
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int InvoiceId { get; set; }
    private Invoices? invoice;
    private bool isProcessing = false;
    private bool isLoaded = false; // Track actual load state

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Use AsNoTracking() for the read operation to improve performance
            // and reduce memory pressure on the DbContext
            var result = await db.Invoices
                .AsNoTracking()
                .Include(i => i.Customer)
                .Include(i => i.InvoiceDetails).ThenInclude(f => f.Foods)
                .FirstOrDefaultAsync(i => i.InvoiceID == InvoiceId);

            if (result == null || result.DeliveryID != UserSession.UserId)
            {
                navigation.NavigateTo("/delivery_mydelivery");
                return;
            }

            invoice = result;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading invoice: {ex.Message}");
            navigation.NavigateTo("/delivery_mydelivery");
        }
        finally
        {
            isLoaded = true;
            StateHasChanged(); // Force UI update to clear the spinner
        }
    }

    private async Task MarkAsComplete()
    {
        // Prevent double-clicks which cause DbContext crashes
        if (invoice == null || isProcessing) return;

        isProcessing = true;
        try
        {
            // Attach the invoice to the current context if it was loaded with AsNoTracking
            var dbInvoice = await db.Invoices.FindAsync(InvoiceId);
            if (dbInvoice != null)
            {
                dbInvoice.Status = InvoiceStatus.Completed;
                await db.SaveChangesAsync();
                navigation.NavigateTo("/delivery_mydelivery");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            isProcessing = false; // Re-enable button on error
        }
    }
}

<style>
    .uppercase {
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 700;
    }

    .custom-card {
        border: 1px solid var(--current-border);
        border-radius: 12px;
        overflow: hidden;
    }
</style>