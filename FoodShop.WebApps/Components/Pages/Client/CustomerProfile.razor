@page "/customer-profile/{id:int}"
@using FoodShop.Data
@using Microsoft.EntityFrameworkCore
@inject NavigationManager NavManager
@inject FoodShopDbContext db

<div class="container my-5">
    @if (customer == null)
    {
        <div class="d-flex justify-content-center align-items-center" style="height: 300px;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading customer profile...</span>
            </div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="alert alert-success py-2">@statusMessage</div>
        }
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger py-2">@errorMessage</div>
        }

        <div class="row g-4">

            <div class="col-md-4">
                <div class="card shadow-sm border-0 text-center p-4">
                    <div class="position-relative d-inline-block mx-auto mb-3">
                        <div class="rounded-circle img-thumbnail d-flex align-items-center justify-content-center bg-light text-primary mx-auto"
                             style="width: 120px; height: 120px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-person-bounding-box" viewBox="0 0 16 16">
                                <path d="M1.5 1a.5.5 0 0 0-.5.5v3a.5.5 0 0 1-1 0v-3A1.5 1.5 0 0 1 1.5 0h3a.5.5 0 0 1 0 1zM11 .5a.5.5 0 0 1 .5-.5h3A1.5 1.5 0 0 1 16 1.5v3a.5.5 0 0 1-1 0v-3a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 1-.5-.5M.5 11a.5.5 0 0 1 .5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 1 0 1h-3A1.5 1.5 0 0 1 0 14.5v-3a.5.5 0 0 1 .5-.5m15 0a.5.5 0 0 1 .5.5v3a1.5 1.5 0 0 1-1.5 1.5h-3a.5.5 0 0 1 0-1h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 1 .5-.5M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6" />
                            </svg>
                        </div>
                        <span class="position-absolute bottom-0 end-0 border border-white rounded-circle p-2 @(customer.Status == CustomerStatus.Active ? "bg-success" : "bg-danger")"
                              title="@customer.Status"></span>
                    </div>

                    <h4 class="mb-1">@customer.CustomerName</h4>
                    <p class="text-muted small mb-3">@customer.Email</p>

                    <div class="d-flex justify-content-center gap-2 mb-4">
                        <span class="badge @(customer.Status == CustomerStatus.Active ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") px-3 py-2 rounded-pill">
                            @customer.Status
                        </span>
                    </div>

                    <hr class="text-muted">

                    <div class="row text-center my-2">
                        <div class="col">
                            <h6 class="mb-0 fw-bold">Total Orders</h6>
                            <small class="text-muted">@customer.Invoices?.Count</small>
                        </div>
                        <div class="col border-start">
                            <h6 class="mb-0 fw-bold">Customer since</h6>
                            <small class="text-muted">@customer.CreatedAt?.ToString("MMM yyyy")</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <div class="card shadow-sm border-0 p-4">

                    <ul class="nav nav-tabs mb-4" id="customerTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(activeTab == "info" ? "active fw-bold" : "")"
                                    @onclick='() => SwitchTab("info")' type="button">
                                Personal Information
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(activeTab == "security" ? "active fw-bold" : "")"
                                    @onclick='() => SwitchTab("security")' type="button">
                                Security
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content">
                        @if (activeTab == "info")
                        {
                            <EditForm Model="@customer" OnValidSubmit="HandleSave">
                                <DataAnnotationsValidator />

                                <div class="row g-3">
                                    <div class="col-sm-6">
                                        <label class="form-label small fw-bold">Customer Name</label>
                                        <InputText @bind-Value="customer.CustomerName" class="form-control" />
                                    </div>

                                    <div class="col-sm-6">
                                        <label class="form-label small fw-bold">Phone Number</label>
                                        <InputText @bind-Value="customer.Phone" class="form-control" />
                                    </div>

                                    <div class="col-sm-6">
                                        <label class="form-label small fw-bold">Email Address</label>
                                        <InputText @bind-Value="customer.Email" class="form-control" disabled />
                                    </div>

                                    <div class="col-sm-6">
                                        <label class="form-label small fw-bold">Date of Birth</label>
                                        <InputDate @bind-Value="customer.DateBirth" class="form-control" />
                                    </div>

                                    <div class="col-sm-6">
                                        <label class="form-label small fw-bold">Account Status</label>
                                        <InputSelect @bind-Value="customer.Status" class="form-select">
                                            @foreach (var status in Enum.GetValues<CustomerStatus>())
                                            {
                                                <option value="@status">@status</option>
                                            }
                                        </InputSelect>
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label small fw-bold">Delivery Address</label>
                                        <InputText @bind-Value="customer.Address" class="form-control" />
                                    </div>
                                </div>

                                <div class="mt-4 d-flex justify-content-end">
                                    <button type="submit" class="btn btn-primary px-4">Save Profile</button>
                                </div>
                            </EditForm>
                        }
                        else if (activeTab == "security")
                        {
                            <div>
                                <h5 class="mb-3 text-danger-emphasis">Reset Customer Password</h5>
                                <div class="row g-3" style="max-width: 400px;">
                                    @* <div class="col-12">
                                        <label class="form-label small fw-bold">Current Password</label>
                                        <input type="password" @bind="currentPassword" class="form-control" />
                                    </div> *@
                                    <div class="col-12">
                                        <label class="form-label small fw-bold">New Password</label>
                                        <input type="password" @bind="newPassword" class="form-control" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label small fw-bold">Confirm Password</label>
                                        <input type="password" @bind="confirmPassword" class="form-control " />
                                    </div>
                                </div>

                                <div class="mt-4 d-flex justify-content-end">
                                    <button type="button" @onclick="UpdatePassword" class="btn btn-danger px-4">Force Password Update</button>
                                </div>
                            </div>
                        }
                    </div>

                </div>
            </div>

        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private Customer? customer;
    private string activeTab = "info";
    // private string currentPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private string? statusMessage;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadCustomerDataAsync();
    }

    private async Task LoadCustomerDataAsync()
    {
        customer = await db.Customers
            .Include(c => c.Invoices)
            .FirstOrDefaultAsync(c => c.CustomerID == Id);

        ClearFormMessages();
    }

    private void SwitchTab(string tabName)
    {
        activeTab = tabName;
        ClearFormMessages();
    }

    private void ClearFormMessages()
    {
        newPassword = "";
        confirmPassword = "";
        statusMessage = null;
        errorMessage = null;
    }

    private async Task HandleSave()
    {
        if (customer == null) return;

        try
        {
            statusMessage = null;
            errorMessage = null;

            await db.SaveChangesAsync();
            statusMessage = "Customer record updated successfully!";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error updating database profile: {ex.Message}";
        }
    }

    private async Task UpdatePassword()
    {
        if (customer == null) return;

        statusMessage = null;
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(newPassword))
        {
            errorMessage = "Password field cannot be empty.";
            return;
        }

        if (newPassword != confirmPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        try
        {
            customer.Password = newPassword; 
            await db.SaveChangesAsync();

            ClearFormMessages();
            statusMessage = "Customer password updated successfully!";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error modifying password settings: {ex.Message}";
        }
    }
}