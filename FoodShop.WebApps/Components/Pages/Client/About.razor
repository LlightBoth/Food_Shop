@page "/about"

<PageTitle>About Us</PageTitle>

<link href="/css/client/about.css" rel="stylesheet" />

<!-- Hero Section -->
<section class="about-hero">
    <div class="hero-content">
        <h1>About FoodieHub</h1>
        <p>Delivering your favorite foods fast and fresh, trusted by thousands in your town.</p>
    </div>
</section>

<!-- Our Story -->
<section class="our-story">
    <h2>Our Story</h2>
    <p>
        Founded in 2022, FoodieHub began with a simple mission: to bring delicious meals right to your doorstep.
        We work with local restaurants and food artisans to ensure freshness, quality, and a variety of flavors for every taste.
    </p>
</section>

<!-- Mission & Values -->
<section class="mission-values">
    <div class="mission">
        <h3>Our Mission</h3>
        <p>To make food delivery fast, reliable, and enjoyable for everyone.</p>
    </div>
    <div class="values">
        <h3>Our Values</h3>
        <ul>
            <li>Freshness first – quality ingredients every time.</li>
            <li>Speed and reliability – because hunger doesn’t wait.</li>
            <li>Community-focused – supporting local businesses.</li>
            <li>Customer satisfaction – your happiness is our priority.</li>
        </ul>
    </div>
</section>

<!-- Team or Highlights (Optional) -->
<section class="about-highlights">
    <h2>Why Choose Us?</h2>
    <div class="highlights-grid">
        <div class="highlight">
            <h4>Fast Delivery</h4>
            <p>Get your meals in record time with our optimized delivery network.</p>
        </div>
        <div class="highlight">
            <h4>Wide Variety</h4>
            <p>From comfort food to gourmet dishes, we’ve got something for everyone.</p>
        </div>
        <div class="highlight">
            <h4>Trusted Restaurants</h4>
            <p>We partner with verified local eateries to ensure top quality every time.</p>
        </div>
    </div>
</section>

